.wrap{max-width:1080px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
.theme-head{padding:60px 0 28px}
.theme-kicker{font:11.5px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--signal);font-weight:800;margin:0 0 16px}
.theme-head h1{font-size:clamp(34px,5.4vw,60px);line-height:1.02;letter-spacing:-.035em;margin:0 0 18px}
.theme-dek{font-size:18px;line-height:1.6;color:rgba(255,255,255,.68);max-width:70ch;margin:0 0 14px}
.theme-count{font:11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.45);margin:0}
.gallery-bar{display:flex;justify-content:flex-end;padding:10px 0 20px;border-bottom:1px solid var(--line);margin-bottom:26px}
.gallery-views{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.gallery-view-btn{padding:7px 16px;background:transparent;border:0;color:rgba(255,255,255,.55);font:11px var(--mono);text-transform:uppercase;letter-spacing:.1em;cursor:pointer}
.gallery-view-btn[aria-pressed=true]{background:var(--signal);color:#fff}
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
.gcard{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,#171415,#211b1c);overflow:hidden}
.gcard-hit{display:block;padding:24px 22px 18px;text-decoration:none;color:inherit;flex:1}
.gcard-hit:hover .gcard-title{color:var(--signal)}
.gcard-meta{font:10.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.42);margin:0 0 12px}
.gcard-title{font-size:20px;line-height:1.25;letter-spacing:-.02em;margin:0 0 12px}
.gcard-brief{font-size:14.5px;line-height:1.6;color:rgba(255,255,255,.66);margin:0}
.gcard-foot{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:14px 22px;border-top:1px solid var(--line)}
.gcard-link{font:10.5px var(--mono);text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.6);text-decoration:none;border-bottom:1px solid rgba(255,255,255,.2)}
.gcard-link:hover{color:var(--signal)}
.badge{font:10px var(--mono);text-transform:uppercase;letter-spacing:.1em;padding:4px 9px;border-radius:999px;border:1px solid var(--line);color:rgba(255,255,255,.7)}
.badge-audio{border-color:rgba(46,125,91,.6)}
.badge-deck{border-color:rgba(232,23,45,.5)}
.gallery-list{display:flex;flex-direction:column}
.grow{display:flex;gap:20px;justify-content:space-between;align-items:flex-start;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.grow-title{font-size:19px;line-height:1.3;letter-spacing:-.02em;color:#fff;text-decoration:none;display:block;margin-bottom:8px}
.grow-title:hover{color:var(--signal)}
.grow-brief{font-size:14.5px;line-height:1.6;color:rgba(255,255,255,.62);margin:0 0 8px;max-width:76ch}
.grow-meta{font:10.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.4);margin:0}
.grow-side{display:flex;gap:8px;flex-shrink:0}
.gallery-empty{color:rgba(255,255,255,.5);padding:30px 0}
@media (max-width:640px){.grow{flex-direction:column;gap:10px}}

/* --- Console de autoria (só visível em localhost) --- */
.console{border:1px solid var(--line);border-radius:16px;padding:22px;margin-bottom:30px;background:rgba(255,255,255,.02)}
.console-head{display:flex;justify-content:space-between;align-items:center;gap:14px}
.console-head h2{font-size:16px;margin:0;letter-spacing:-.01em}
.console-add{padding:8px 15px;border-radius:999px;border:1px solid var(--signal);background:transparent;color:var(--signal);font:11px var(--mono);text-transform:uppercase;letter-spacing:.1em;cursor:pointer}
.console-add:hover{background:var(--signal);color:#fff}
.console-form{display:grid;gap:14px;margin-top:20px;max-width:520px}
.console-form span{display:block;font:10.5px var(--mono);text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.5);margin-bottom:6px}
.console-form input[type=text]{width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--line);background:rgba(0,0,0,.25);color:#fff;font-size:14px}
.console-run{justify-self:start;padding:10px 20px;border-radius:8px;border:0;background:var(--signal);color:#fff;font:11px var(--mono);text-transform:uppercase;letter-spacing:.1em;cursor:pointer}
.console-run-panel{margin-top:22px;border-top:1px solid var(--line);padding-top:20px}
.console-progress-total{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.console-pct{font:13px var(--mono);color:var(--signal);min-width:44px}
.console-bar{flex:1;height:7px;border-radius:999px;background:rgba(255,255,255,.09);overflow:hidden}
.console-bar i{display:block;height:100%;background:var(--signal);transition:width .35s ease}
.console-bar-sm{height:5px;max-width:180px}
.console-phases{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:8px}
.console-phase{display:flex;align-items:center;gap:12px;font:10.5px var(--mono);text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.45)}
.console-phase-name{min-width:120px}
.console-phase-pct{min-width:40px;text-align:right}
.console-phase.is-active{color:#fff}
.console-phase.is-done{color:rgba(46,125,91,.9)}
.console-working h3{display:flex;align-items:center;gap:10px;font-size:13px;margin:0 0 12px;color:rgba(255,255,255,.8)}
.spinner{width:13px;height:13px;border-radius:50%;border:2px solid rgba(255,255,255,.2);border-top-color:var(--signal);display:inline-block;animation:console-spin .8s linear infinite}
@keyframes console-spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spinner{animation-duration:2.4s}}
.console-log{max-height:220px;overflow:auto;background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:10px;padding:14px;font:11.5px var(--mono);color:rgba(255,255,255,.7);white-space:pre-wrap;margin:0}
.console-done{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
.console-chip{font:10px var(--mono);text-transform:uppercase;letter-spacing:.08em;padding:4px 9px;border-radius:999px;border:1px solid rgba(46,125,91,.5);color:rgba(255,255,255,.65)}
.gcard-fresh{outline:1px solid var(--signal);outline-offset:2px}
