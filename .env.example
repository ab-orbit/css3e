# OpenRouter — LLM calls for every extraction/generation node.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional cheaper model for low-stakes nodes (SEO boilerplate, downloads grid).
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini

# Site
SITE_BASE_URL=https://ab-orbit.github.io/css3e/
DEFAULT_AUTHORS="Bruna Juliana Melo da Costa,Jefferson Wellington da Cunha"
DEFAULT_PUBLISHER_NAME="Centro de Informática, UFPE"

# notebooklm-py — audio overview + slide deck generation.
# Bootstrap once locally with `notebooklm login`, then:
#   base64 -i ~/.notebooklm/profiles/default/storage_state.json | tr -d '\n'
# Session expires every few weeks — re-run the login + re-encode periodically.
NOTEBOOKLM_AUTH_JSON=

# PDF extraction backend: calia (default, remote Markdown conversion),
# pdftotext (poppler, local) or pypdf (pure-Python, local).
PDF_EXTRACTOR=calia

# Aeonbridge Calia — converts the PDF to structured Markdown (headings, tables,
# inline math) and returns it as data.cleaned_text, plus an injection_signals
# heuristic scan. Only required when PDF_EXTRACTOR=calia.
CALIA_API_URL=https://aeonbridge.io/calia
CALIA_API_KEY=
CALIA_INCLUDE_RAW=false
CALIA_REDACT=none
CALIA_TIMEOUT_SECONDS=180

# Optional: LangSmith tracing for debugging the LangGraph run.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=css3e-pipeline
LANGCHAIN_API_KEY=

# Entity/relation extraction (GLiNER + LLM). Off by default: enabling pulls
# torch and downloads ~2GB of models into ENTITY_MODEL_DIR.
ENTITY_EXTRACTION=true
ENTITY_MODEL_DIR=/Volumes/T9/lm-studio/models/hf
